# I_L

units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check no

read_data       final-0GPa-1500.data
mass            1 55.845
mass            2 10.810


pair_style      mace no_domain_decomposition
pair_coeff      * * /home/svu/zihan.zhang/scratch/Fe-B/mace-mh-1_finetuned_FeB_mixed.model-lammps.pt Fe B 

#velocity        all create 1800.0 8257 dist gaussian mom yes

fix             npt_run all npt   temp 1500.0 1500.0 0.1   iso 1 1 1.0
timestep        0.001
thermo_style    custom step pe ke etotal temp press vol
thermo          100
dump            1 all custom 100 SUPERCELL.dump id type xu yu zu vx vy vz

run             500000
write_data        final.data
